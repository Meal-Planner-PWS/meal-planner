# Turso cloud database (used by Netlify functions)
# Create a database at https://turso.tech and get these values
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token

# Spoonacular API key for recipe search (New Ideas page)
# Get a free key at https://spoonacular.com/food-api/console
VITE_SPOONACULAR_KEY=your_key_here
